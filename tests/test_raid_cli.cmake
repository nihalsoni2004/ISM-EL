cmake_minimum_required(VERSION 3.21)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/raid-array-cli-test-${suffix}")
set(bin "${root}/build/Debug")
set(catalog "${root}/data/metadata/raid_arrays")
file(MAKE_DIRECTORY "${bin}" "${root}/unrelated" "${root}/outside")
file(WRITE "${root}/CMakeLists.txt" "")
file(WRITE "${root}/CMakePresets.json" "{}")
file(COPY "${SIMULATOR}" DESTINATION "${bin}")
get_filename_component(name "${SIMULATOR}" NAME)
set(exe "${bin}/${name}")

function(run expected pattern)
    execute_process(COMMAND "${exe}" ${ARGN}
        WORKING_DIRECTORY "${root}/unrelated"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result STREQUAL "${expected}" OR NOT "${out}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Command [${ARGN}] returned ${result}. Output was [${out}${error}].")
    endif()
    set(lastOutput "${out}" PARENT_SCOPE)
endfunction()

function(junction link target)
    file(TO_NATIVE_PATH "${link}" nativeLink)
    file(TO_NATIVE_PATH "${target}" nativeTarget)
    execute_process(COMMAND cmd.exe /d /c mklink /J "${nativeLink}" "${nativeTarget}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not create test junction. [${out}${error}]")
    endif()
endfunction()

function(removeJunction link)
    file(TO_NATIVE_PATH "${link}" nativeLink)
    execute_process(COMMAND cmd.exe /d /c rmdir "${nativeLink}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not remove test junction [${link}].")
    endif()
endfunction()

run(2 "identifier" raid create "../array0" raid0 disk0 disk1)
run(2 "Unsupported RAID level" raid create array0 raid7 disk0 disk1)
run(2 "member disk identifier" raid create array0 raid0 "../disk0" disk1)
run(2 "unsigned decimal integer" raid read array0 -1)
run(2 "unsigned decimal integer" raid map array0 18446744073709551616)
if(EXISTS "${root}/data")
    message(FATAL_ERROR "Syntactically invalid RAID command created storage.")
endif()

run(0 "No configured arrays" raid list)
foreach(index RANGE 0 7)
    run(0 "Created disk${index}" disk create disk${index} 1)
endforeach()
run(0 "Wrote 4 UTF-8 bytes" disk write disk7 255 used)
run(2 "contains nonzero data" raid create array0 raid0 disk6 disk7)
run(0 "Text: used" disk read disk7 255)
run(2 "stripe unit must divide" raid create array0 raid0 disk0 disk1 --stripe 3)
run(2 "stripe unit must be positive" raid create array0 raid0 disk0 disk1 --stripe 0)
run(2 "requires two members" raid create array0 raid1 disk0 disk1 disk2)
run(2 "--stripe applies" raid create array0 raid1 disk0 disk1 --stripe 1)
run(2 "Duplicate RAID member" raid create array0 raid0 disk0 disk0)
run(1 "Cannot open RAID member disk8" raid create array0 raid0 disk0 disk8)
run(0 "No configured arrays" raid list)

run(0 "Created array0 [(]RAID 0, 2 MiB usable, disk0,disk1[)]" raid create array0 raid0 disk0 disk1)
run(0 "Created array1 [(]RAID 1, 1 MiB usable, disk2,disk3[)]" raid create array1 raid1 disk2 disk3)
run(0 "array0 +RAID 0 +2 MiB +disk0,disk1" raid list)
if(NOT lastOutput MATCHES "array1 +RAID 1 +1 MiB +disk2,disk3")
    message(FATAL_ERROR "RAID list did not show the second persisting array.")
endif()
run(0 "Stripe unit: 16 blocks" raid info array0)
run(0 "Healthy" raid info array1)
run(2 "already exists" raid create array0 raid0 disk4 disk5)
run(2 "already belongs" raid create array2 raid1 disk1 disk4)

run(0 "Wrote 10 UTF-8 bytes" raid write array0 20 "Hello RAID")
run(0 "Text: Hello RAID" raid read array0 20)
run(0 "logical LBA 20 -> disk1 physical LBA 4" raid map array0 20)
run(0 "Text: Hello RAID" disk read disk1 4)
run(0 "all zeros" disk read disk0 4)
run(1 "outside the RAID array" raid read array0 512)
run(0 "readable mapped samples" raid verify array0)

run(0 "Wrote 8 UTF-8 bytes" raid write array1 20 "RAID 雪")
run(0 "Text: RAID 雪" raid read array1 20)
run(0 "disk2 physical LBA 20" raid map array1 20)
if(NOT lastOutput MATCHES "disk3 physical LBA 20")
    message(FATAL_ERROR "RAID 1 mapping omitted the second location.")
endif()
run(0 "Text: RAID 雪" disk read disk2 20)
run(0 "Text: RAID 雪" disk read disk3 20)
run(0 "identical RAID 1 mirrors across all 256" raid verify array1)
run(0 "Degraded; disk2 unavailable for this command[.] Read from disk3" raid demo-degraded-read array1 disk2 20)
if(NOT lastOutput MATCHES "Text: RAID 雪" OR EXISTS "${catalog}/array1.pending")
    message(FATAL_ERROR "Session-scoped degradation changed persistence or returned the wrong payload.")
endif()
run(0 "Status: Healthy" raid info array1)
run(2 "Raw write rejected[.] disk2 belongs" disk write disk2 20 forbidden)
run(0 "Text: RAID 雪" disk read disk2 20)
set(image "${root}/data/virtual_disks/disk2.img")
file(RENAME "${image}" "${image}.saved")
run(0 "disk2 +FAILED +Missing +MISSING_IMAGE" raid members array1)
run(2 "disk2 belongs" disk create disk2 1)
if(EXISTS "${image}")
    message(FATAL_ERROR "An owned member was replaced with a blank disk.")
endif()
file(RENAME "${image}.saved" "${image}")
run(0 "disk2 +FAILED +Present +MISSING_IMAGE" raid members array1)
run(2 "not a member" raid demo-degraded-read array1 disk4 20)

# A cross-process race must either claim a blank disk or let the raw write succeed.
execute_process(
    COMMAND "${exe}" raid create array2 raid0 disk4 disk5 --stripe 1
    COMMAND "${exe}" disk write disk4 0 race
    WORKING_DIRECTORY "${root}/unrelated"
    RESULTS_VARIABLE races OUTPUT_QUIET ERROR_QUIET)
list(SORT races)
if(NOT races STREQUAL "0;2")
    message(FATAL_ERROR "Exactly one operation must win the ownership race. Got [${races}].")
endif()
if(EXISTS "${catalog}/array2.raid")
    run(0 "Stripe unit: 1 blocks" raid info array2)
    run(0 "all zeros" disk read disk4 0)
else()
    run(0 "Text: race" disk read disk4 0)
    run(2 "does not exist" raid info array2)
endif()

# Two overlapping array creations must also have exactly one winner.
foreach(index RANGE 9 11)
    run(0 "Created disk${index}" disk create disk${index} 1)
endforeach()
execute_process(
    COMMAND "${exe}" raid create array5 raid0 disk9 disk10 --stripe 1
    COMMAND "${exe}" raid create array6 raid0 disk10 disk11 --stripe 1
    WORKING_DIRECTORY "${root}/unrelated"
    RESULTS_VARIABLE races OUTPUT_QUIET ERROR_QUIET)
list(SORT races)
if(NOT races STREQUAL "0;2")
    message(FATAL_ERROR "Exactly one array may claim the shared member. Got [${races}].")
endif()
file(GLOB staging "${catalog}/*.tmp")
if(staging)
    message(FATAL_ERROR "RAID catalog contains leftover staging files.")
endif()

junction("${catalog}/array9.raid" "${root}/outside")
run(2 "without links" raid list)
removeJunction("${catalog}/array9.raid")
file(RENAME "${catalog}" "${catalog}-original")
junction("${catalog}" "${root}/outside")
run(2 "without reparse points" raid list)
run(2 "without reparse points" disk write disk6 0 forbidden)
removeJunction("${catalog}")
run(0 "all zeros" disk read disk6 0)
file(REMOVE_RECURSE "${root}")
