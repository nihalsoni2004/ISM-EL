cmake_minimum_required(VERSION 3.21)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/failure-cli-${suffix}")
set(bin "${root}/build/Debug")
set(catalog "${root}/data/metadata/raid_arrays")
set(images "${root}/data/virtual_disks")
file(MAKE_DIRECTORY "${bin}" "${root}/unrelated")
file(WRITE "${root}/CMakeLists.txt" "")
file(WRITE "${root}/CMakePresets.json" "{}")
file(COPY "${SIMULATOR}" DESTINATION "${bin}")
get_filename_component(name "${SIMULATOR}" NAME)
set(exe "${bin}/${name}")

function(run expected pattern)
    execute_process(COMMAND "${exe}" ${ARGN} WORKING_DIRECTORY "${root}/unrelated"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result STREQUAL "${expected}" OR NOT "${out}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Command [${ARGN}] returned ${result}. Output was [${out}${error}].")
    endif()
    set(lastOutput "${out}" PARENT_SCOPE)
endfunction()

function(checkOutput)
    foreach(pattern IN LISTS ARGN)
        if(NOT lastOutput MATCHES "${pattern}")
            message(FATAL_ERROR "Expected [${pattern}] in [${lastOutput}].")
        endif()
    endforeach()
endfunction()

foreach(index RANGE 0 3)
    run(0 "Created disk${index}" disk create disk${index} 1)
endforeach()
run(0 "Created array0" raid create array0 raid6 disk0 disk1 disk2 disk3)
run(0 "Array health: HEALTHY" raid status array0)
checkOutput("Healthy members: 4" "Failed members: 0" "Maximum tolerated failures: 2"
            "Write consistency: Clear" "Reads permitted: Yes" "Writes permitted: Yes")
run(0 "disk1 +ONLINE +Present +NONE" raid members array0)
run(0 "Wrote" raid write array0 20 "Persistent recovery")
run(2 "identifier" raid fail array0 "../disk1")
run(2 "not a member" raid fail array0 disk4)
run(2 "Expected an array identifier" raid fail "../array0" disk1)
run(2 "does not exist" raid fail array1 disk1)
if(EXISTS "${catalog}/array0.state")
    message(FATAL_ERROR "Invalid failure published state.")
endif()

file(SHA256 "${catalog}/array0.raid" catalogueBefore)
foreach(index RANGE 0 3)
    file(SHA256 "${images}/disk${index}.img" before${index})
endforeach()

# Both CLI processes must merge their updates under the catalog lock.
execute_process(
    COMMAND "${exe}" raid fail array0 disk0
    COMMAND "${exe}" raid fail array0 disk1
    WORKING_DIRECTORY "${root}/unrelated"
    RESULTS_VARIABLE outcomes OUTPUT_QUIET ERROR_QUIET)
if(NOT outcomes STREQUAL "0;0")
    message(FATAL_ERROR "Concurrent failure requests failed [${outcomes}].")
endif()
run(0 "Array health: DEGRADED" raid status array0)
checkOutput("Healthy members: 2" "Failed members: 2" "Reads permitted: Yes" "Writes permitted: No")
run(0 "disk0 +FAILED +Present +INJECTED" raid members array0)
checkOutput("disk1 +FAILED +Present +INJECTED")
run(0 "array0 +RAID 6 +2 MiB +disk0,disk1,disk2,disk3 +DEGRADED" raid list)
run(0 "already FAILED" raid fail array0 disk1)
run(0 "Text: Persistent recovery" raid read array0 20)
checkOutput("Reconstructed data using P and Q parity")
run(1 "is DEGRADED" raid write array0 20 forbidden)
run(2 "Raw write rejected" disk write disk1 4 forbidden)
run(1 "verification requires every member" raid verify array0)

run(0 "Array health: FAILED" raid fail array0 disk2)
run(0 "Array health: FAILED" raid status array0)
checkOutput("Reads permitted: No" "Writes permitted: No")
run(1 "is FAILED" raid read array0 20)
run(1 "is FAILED" raid write array0 20 forbidden)
file(CONFIGURE OUTPUT "${catalog}/array0.pending"
    CONTENT "schema_version=1\nparity_write=pending\n" NEWLINE_STYLE UNIX)
run(0 "Array health: INCONSISTENT" raid status array0)
checkOutput("Failed members: 3" "Pending write marker: Present" "Write consistency: Unresolved"
            "Reads permitted: No" "Writes permitted: No")
run(0 "Array health: INCONSISTENT" raid fail array0 disk3)
run(1 "RAID 6 is inconsistent" raid read array0 20)
if(NOT EXISTS "${catalog}/array0.pending")
    message(FATAL_ERROR "Failure injection cleared a write-consistency marker.")
endif()

foreach(index RANGE 0 3)
    file(SHA256 "${images}/disk${index}.img" after)
    if(NOT after STREQUAL before${index})
        message(FATAL_ERROR "Failure injection modified an image.")
    endif()
endforeach()
file(SHA256 "${catalog}/array0.raid" catalogueAfter)
if(NOT catalogueBefore STREQUAL catalogueAfter)
    message(FATAL_ERROR "Failure injection modified array geometry metadata.")
endif()
file(GLOB staging "${catalog}/*.tmp")
if(staging)
    message(FATAL_ERROR "Failure updates left staging files [${staging}].")
endif()

file(REMOVE_RECURSE "${root}")
