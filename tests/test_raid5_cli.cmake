cmake_minimum_required(VERSION 3.21)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/raid5-cli-${suffix}")
set(bin "${root}/build/Debug")
set(images "${root}/data/virtual_disks")
set(catalog "${root}/data/metadata/raid_arrays")
set(metadata "${catalog}/array0.raid")
file(MAKE_DIRECTORY "${bin}" "${root}/unrelated")
file(WRITE "${root}/CMakeLists.txt" "")
file(WRITE "${root}/CMakePresets.json" "{}")
file(COPY "${SIMULATOR}" DESTINATION "${bin}")
get_filename_component(name "${SIMULATOR}" NAME)
set(exe "${bin}/${name}")

function(run expected pattern)
    execute_process(COMMAND "${exe}" ${ARGN} WORKING_DIRECTORY "${root}/unrelated"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result STREQUAL "${expected}" OR NOT "${out}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Command [${ARGN}] returned ${result}. Output was [${out}${error}].")
    endif()
    set(lastOutput "${out}" PARENT_SCOPE)
endfunction()

function(checkOutput)
    foreach(pattern IN LISTS ARGN)
        if(NOT lastOutput MATCHES "${pattern}")
            message(FATAL_ERROR "Expected [${pattern}] in [${lastOutput}].")
        endif()
    endforeach()
endfunction()

foreach(index RANGE 0 5)
    run(0 "Created disk${index}" disk create disk${index} 1)
endforeach()
run(2 "at least three members" raid create array0 raid5 disk0 disk1)
run(2 "must be positive" raid create array0 raid5 disk0 disk1 disk2 --stripe 0)
run(2 "must divide" raid create array0 raid5 disk0 disk1 disk2 --stripe 3)
run(2 "Duplicate RAID member" raid create array0 raid5 disk0 disk1 disk1)
run(2 "between 1 and 4096" raid write-blocks array0 0 4097 invalid)
run(1 "Cannot open RAID member disk9" raid create array0 raid5 disk0 disk1 disk9)
run(0 "Created array0 [(]RAID 5, 3 MiB usable" raid create array0 raid5 disk0 disk1 disk2 disk3)
run(0 "Created array1 [(]RAID 1, 1 MiB usable" raid create array1 raid1 disk4 disk5)
run(0 "RAID 5 +3 MiB" raid list)
checkOutput("RAID 1 +1 MiB")
run(0 "Raw capacity: 4 MiB" raid info array0)
checkOutput("Stripe unit: 16 blocks" "Logical capacity: 3 MiB" "Parity layout: left_asymmetric_v1" "Status: Healthy")
run(0 "Rows checked: 16" raid verify array0)
checkOutput("Parity mismatches: 0" "Result: PASSED")

run(0 "Data: disk1 physical LBA 4" raid map array0 20)
checkOutput("stripe row 0" "Parity: disk3 physical LBA 4")
run(0 "Data: disk3 physical LBA 16" raid map array0 80)
checkOutput("stripe row 1" "Parity: disk2 physical LBA 16")
run(0 "Wrote 11 UTF-8 bytes" raid write array0 20 "Hello RAID5")
checkOutput("Physical block reads: 2" "Physical block writes: 2" "Physical I/O requests: 4" "Partial-stripe rows: 1")
run(0 "Wrote 48 logical blocks" raid write-blocks array0 48 48 "Full stripe")
checkOutput("Physical block reads: 0" "Physical block writes: 64" "Physical I/O requests: 4" "Full-stripe rows: 1")
run(0 "Text: Hello RAID5" raid read array0 20)
run(0 "Text: Full stripe" raid read array0 95)
run(1 "outside the RAID array" raid map array0 768)
run(0 "Result: PASSED" raid verify array0)

file(SHA256 "${images}/disk1.img" beforeData)
file(SHA256 "${images}/disk3.img" beforeParity)
run(0 "Reconstructed data from surviving members" raid demo-degraded-read array0 disk1 20)
checkOutput("Status: Degraded" "Text: Hello RAID5" "Physical block reads: 3")
run(0 "The unavailable member holds parity for this row" raid demo-degraded-read array0 disk3 20)
checkOutput("Status: Degraded" "Read from disk1" "Text: Hello RAID5" "Physical block reads: 1")
run(0 "Status: Healthy" raid info array0)
run(2 "Raw write rejected" disk write disk1 4 forbidden)
file(SHA256 "${images}/disk1.img" afterData)
file(SHA256 "${images}/disk3.img" afterParity)
if(NOT beforeData STREQUAL afterData OR NOT beforeParity STREQUAL afterParity OR EXISTS "${catalog}/array0.pending")
    message(FATAL_ERROR "Session-scoped availability or rejected write modified storage.")
endif()

file(READ "${metadata}" valid)
string(REPLACE "layout=left_asymmetric_v1" "layout=unsupported" unsupported "${valid}")
file(WRITE "${metadata}" "${unsupported}")
run(2 "Unsupported RAID 5 parity layout" raid info array0)
string(REPLACE "layout=left_asymmetric_v1\n" "" missing "${valid}")
file(WRITE "${metadata}" "${missing}")
run(2 "Expected RAID metadata field layout" raid info array0)
string(REPLACE "capacity_blocks=768" "capacity_blocks=767" wrongCapacity "${valid}")
file(WRITE "${metadata}" "${wrongCapacity}")
run(2 "stripe unit must divide|Invalid RAID metadata capacity" raid info array0)
file(WRITE "${metadata}" "${valid}")


# Corrupt only the isolated fixture using the bytes of an untouched zero-filled test image.
# This copy-based parity corruption fixture uses the legacy format. The identity
# replacement test separately verifies rejection for identity-bound arrays.
string(REGEX REPLACE "member_identities=[^\n]+\n" "" legacy "${valid}")
file(WRITE "${metadata}" "${legacy}")
file(COPY_FILE "${images}/disk5.img" "${images}/disk3.img")
run(1 "Parity mismatches: 2" raid verify array0)
checkOutput("Rows checked: 16" "Result: FAILED")
run(0 "Inconsistent [(]parity recovery required[)]" raid info array0)
run(1 "RAID 5 is inconsistent" raid read array0 20)
run(1 "RAID 5 is inconsistent" raid write array0 20 new)
file(READ "${catalog}/array0.pending" pending)
if(NOT pending STREQUAL "schema_version=1\nparity_write=pending\n")
    message(FATAL_ERROR "Parity verification did not persist the expected marker.")
endif()

file(RENAME "${images}/disk1.img" "${images}/disk1.saved")
run(0 "disk1 +FAILED +Missing +MISSING_IMAGE" raid members array0)
run(2 "disk1 belongs" disk create disk1 1)
file(RENAME "${images}/disk1.saved" "${images}/disk1.img")
run(0 "disk1 +FAILED +Present +MISSING_IMAGE" raid members array0)
file(REMOVE_RECURSE "${root}")
