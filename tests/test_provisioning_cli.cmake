# Terminate the test worker without unwinding after its first RAID chunk write.
execute_process(COMMAND "${TESTER}" interrupt-after-write "${root}"
    RESULT_VARIABLE interrupted OUTPUT_VARIABLE out ERROR_VARIABLE error TIMEOUT 30)
if(NOT interrupted STREQUAL "42")
    message(FATAL_ERROR "Expected the worker to exit during allocation [${interrupted}] [${out}${error}].")
endif()
run(0 "Reserved chunks: 2" pool verify pool0)
run(0 "Hex:" raid read array0 63)
run(0 "Allocation state: UNALLOCATED" lun read lun0 63)
run(0 "Allocated physical chunk: 3" lun write lun1 32 "Safely reused")
run(0 "Block is all zeros" lun read lun1 47)
run(0 "Reserved chunks: 0" pool verify pool0)

run(0 "Array health: DEGRADED" raid fail array0 disk0)
run(0 "Text: Hello Thin" lun read lun0 10)
run(1 "is DEGRADED" lun write lun0 32 forbidden)
run(1 "is DEGRADED" lun write lun0 10 forbidden)
run(0 "Physical allocated: 256 KiB" pool info pool0)

# Exercise the real metadata reader and ownership check with a directory junction at a metadata file.
file(RENAME "${catalog}/array0.pool" "${catalog}/array0.saved")
file(TO_NATIVE_PATH "${catalog}/array0.pool" link)
file(TO_NATIVE_PATH "${root}/outside" target)
execute_process(COMMAND cmd.exe /d /c mklink /J "${link}" "${target}" RESULT_VARIABLE created)
if(NOT created STREQUAL "0")
    message(FATAL_ERROR "Cannot create provisioning fixture junction.")
endif()
run(2 "without links" pool list)
execute_process(COMMAND cmd.exe /d /c rmdir "${link}" RESULT_VARIABLE removed)
if(NOT removed STREQUAL "0")
    message(FATAL_ERROR "Cannot remove provisioning fixture junction.")
endif()
file(RENAME "${catalog}/array0.saved" "${catalog}/array0.pool")
run(0 "accounting: PASSED" pool verify pool0)
file(REMOVE_RECURSE "${root}")
