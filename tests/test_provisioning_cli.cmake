cmake_minimum_required(VERSION 3.21)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/provisioning-cli-${suffix}")
set(bin "${root}/build/Debug")
set(catalog "${root}/data/metadata/provisioning")
file(MAKE_DIRECTORY "${bin}" "${root}/outside")
file(WRITE "${root}/CMakeLists.txt" "")
file(WRITE "${root}/CMakePresets.json" "{}")
file(COPY "${SIMULATOR}" DESTINATION "${bin}")
get_filename_component(name "${SIMULATOR}" NAME)
set(exe "${bin}/${name}")

function(run expected pattern)
    execute_process(COMMAND "${exe}" ${ARGN} WORKING_DIRECTORY "${root}/outside"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 30)
    if(NOT result STREQUAL "${expected}" OR NOT "${out}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Command [${ARGN}] returned ${result}. Output was [${out}${error}].")
    endif()
    set(lastOutput "${out}" PARENT_SCOPE)
endfunction()

run(0 "pool create" --help)
run(0 "Storage pools" pool list)
run(0 "Logical volumes" lun list)
run(0 "Created disk0" disk create disk0 1)
run(0 "Created disk1" disk create disk1 1)
run(0 "Created array0" raid create array0 raid1 disk0 disk1)
