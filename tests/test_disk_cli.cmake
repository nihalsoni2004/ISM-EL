cmake_minimum_required(VERSION 3.21)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/raid-cli-test-${suffix}")
set(bin "${root}/build/Debug")
set(store "${root}/data/virtual_disks")
file(MAKE_DIRECTORY "${bin}" "${root}/unrelated" "${root}/outside")
file(WRITE "${root}/CMakeLists.txt" "")
file(WRITE "${root}/CMakePresets.json" "{}")
file(COPY "${SIMULATOR}" DESTINATION "${bin}")
get_filename_component(name "${SIMULATOR}" NAME)
set(exe "${bin}/${name}")

function(run expected pattern)
    execute_process(COMMAND "${exe}" ${ARGN}
        WORKING_DIRECTORY "${root}/unrelated"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result STREQUAL "${expected}" OR NOT "${out}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Command [${ARGN}] returned ${result}. Output was [${out}${error}].")
    endif()
    set(lastOutput "${out}" PARENT_SCOPE)
endfunction()

function(junction link target)
    file(TO_NATIVE_PATH "${link}" nativeLink)
    file(TO_NATIVE_PATH "${target}" nativeTarget)
    execute_process(COMMAND cmd.exe /d /c mklink /J "${nativeLink}" "${nativeTarget}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not create test junction. [${out}${error}]")
    endif()
endfunction()

function(removeJunction link)
    file(TO_NATIVE_PATH "${link}" nativeLink)
    execute_process(COMMAND cmd.exe /d /c rmdir "${nativeLink}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not remove test junction [${link}].")
    endif()
endfunction()

run(0 "disk create" --help)
run(0 "0[.]1[.]0" --version)
run(2 "Unknown command" --unknown)
run(2 "incorrect arguments" disk list disk0)
run(2 "identifier" disk create "../disk0" 1)
run(2 "between 1 and 1024" disk create disk0 0)
run(2 "between 1 and 1024" disk create disk0 1025)
run(2 "unsigned decimal integer" disk create disk0 1.5)
run(2 "unsigned decimal integer" disk read disk0 -1)
run(2 "unsigned decimal integer" disk read disk0 18446744073709551616)
string(REPEAT x 4097 oversized)
# Use a separate check so a failure does not print the oversized argument.
execute_process(COMMAND "${exe}" disk write disk0 0 "${oversized}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result STREQUAL "2" OR NOT error MATCHES "4096-byte block")
    message(FATAL_ERROR "Oversized write was not rejected.")
endif()
if(EXISTS "${root}/data")
    message(FATAL_ERROR "Invalid command created a data directory.")
endif()

run(0 "INITIALIZED" --status)
run(0 "self-test passed" --self-test)
run(0 "No virtual disks found" disk list)
run(1 "Open disk image" disk read disk42 1)
run(0 "Created disk0[.]img" disk create disk0 1)
run(2 "already exists" disk create disk0 2)
file(SIZE "${store}/disk0.img" size)
if(NOT size EQUAL 1048576)
    message(FATAL_ERROR "CLI did not create the expected 1 MiB image.")
endif()
run(0 "disk0 +1 MiB +256" disk list)
run(0 "Blocks: 256" disk info disk0)
run(0 "Wrote 9 UTF-8 bytes" disk write disk0 10 "Hello ISM")
run(0 "48 65 6c 6c 6f 20 49 53 4d" disk read disk0 10)
if(NOT lastOutput MATCHES "Text: Hello ISM" OR NOT lastOutput MATCHES "4087 trailing zero bytes")
    message(FATAL_ERROR "Fresh CLI process did not read the expected text and padding.")
endif()
run(0 "Wrote 9 UTF-8 bytes" disk write disk0 11 "Café 雪")
run(0 "43 61 66 c3 a9 20 e9 9b aa" disk read disk0 11)
if(NOT lastOutput MATCHES "Text: Café 雪")
    message(FATAL_ERROR "UTF-8 display did not survive a fresh process.")
endif()
string(REPEAT x 65 longPreview)
run(0 "Wrote 65 UTF-8 bytes" disk write disk0 12 "${longPreview}")
run(0 "Preview truncated after 64 of 65 bytes" disk read disk0 12)
run(1 "outside the disk" disk write disk0 256 rejected)
run(0 "LBA 0 and LBA 255" disk verify disk0)

# Both processes contend for the same ID. Exactly one can publish it.
execute_process(
    COMMAND "${exe}" disk create disk3 1
    COMMAND "${exe}" disk create disk3 2
    WORKING_DIRECTORY "${root}/unrelated"
    RESULTS_VARIABLE races OUTPUT_QUIET ERROR_QUIET)
list(SORT races)
if(NOT races STREQUAL "0;1" AND NOT races STREQUAL "0;2")
    message(FATAL_ERROR "Expected exactly one successful concurrent create. Got [${races}].")
endif()
file(SIZE "${store}/disk3.img" size)
file(GLOB staging "${store}/.disk-create-*.tmp")
if((NOT size EQUAL 1048576 AND NOT size EQUAL 2097152) OR staging)
    message(FATAL_ERROR "Concurrent creation left an incomplete disk or staging file.")
endif()

# A junction needs no symbolic-link privilege on Windows NTFS.
file(COPY "${store}/disk0.img" DESTINATION "${root}/outside")
junction("${store}/disk8.img" "${root}/outside")
run(2 "without links" disk read disk8 0)
run(2 "without links" spare register disk8)
run(0 "disk0 +1 MiB +256" disk list)
if(lastOutput MATCHES "disk8")
    message(FATAL_ERROR "Disk list exposed an image-path junction.")
endif()
removeJunction("${store}/disk8.img")

file(RENAME "${store}" "${root}/data/original")
junction("${store}" "${root}/outside")
run(2 "without reparse points" disk read disk0 10)
run(2 "without reparse points" disk create disk1 1)
run(2 "without reparse points" spare register disk0)
if(EXISTS "${root}/outside/disk1.img")
    message(FATAL_ERROR "Disk creation escaped its storage directory.")
endif()
removeJunction("${store}")
file(REMOVE_RECURSE "${root}")
