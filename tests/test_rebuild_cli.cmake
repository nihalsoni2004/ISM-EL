cmake_minimum_required(VERSION 3.21)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/rebuild-cli-${suffix}")
set(bin "${root}/build/Debug")
set(images "${root}/data/virtual_disks")
file(MAKE_DIRECTORY "${bin}" "${root}/unrelated")
file(WRITE "${root}/CMakeLists.txt" "")
file(WRITE "${root}/CMakePresets.json" "{}")
file(COPY "${SIMULATOR}" DESTINATION "${bin}")
get_filename_component(name "${SIMULATOR}" NAME)
set(exe "${bin}/${name}")

function(run expected pattern)
    execute_process(COMMAND "${exe}" ${ARGN} WORKING_DIRECTORY "${root}/unrelated"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 30)
    if(NOT result STREQUAL "${expected}" OR NOT "${out}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Command [${ARGN}] returned ${result}. Output was [${out}${error}].")
    endif()
    set(lastOutput "${out}" PARENT_SCOPE)
endfunction()

foreach(index RANGE 0 3)
    run(0 "Created disk${index}" disk create disk${index} 1)
endforeach()
run(0 "Created array0" raid create array0 raid1 disk0 disk1)
run(0 "Wrote" raid write array0 20 "Rebuilt mirror")
run(0 "marked FAILED" raid fail array0 disk0)
file(SHA256 "${images}/disk0.img" original)
run(0 "Registered disk2 as SPARE" spare register disk2)
run(0 "disk2 +1 MiB +SPARE +- +Yes" spare list)
run(2 "registered as a spare" disk write disk2 0 forbidden)
run(2 "array-owned member" spare register disk1)
run(0 "Prepared rebuild rebuild1" raid rebuild prepare array0 disk0 disk2)
run(2 "already has a rebuild assignment" raid rebuild prepare array0 disk0 disk2)
run(0 "Rebuild state: PREPARED" raid status array0)

run(0 "Rebuild state: PAUSED" raid rebuild run rebuild1 --batches 2)
if(NOT lastOutput MATCHES "Completed blocks: 32" OR NOT lastOutput MATCHES "Progress: 12[.]50%")
    message(FATAL_ERROR "Expected a durable 32-block checkpoint: [${lastOutput}].")
endif()
run(0 "Rebuild state: PAUSED" raid rebuild status rebuild1)
if(NOT lastOutput MATCHES "Elapsed to last checkpoint [(]seconds[)]: [0-9]+")
    message(FATAL_ERROR "Expected elapsed checkpoint time in rebuild status: [${lastOutput}].")
endif()
run(0 "disk2 +1 MiB +REBUILDING +rebuild1 +No" spare list)
run(0 "Text: Rebuilt mirror" raid read array0 20)
run(1 "is DEGRADED" raid write array0 20 forbidden)
run(0 "Rebuild state: COMPLETED" raid rebuild resume rebuild1)
if(NOT lastOutput MATCHES "Progress: 100[.]00%")
    message(FATAL_ERROR "Successful rebuild did not reach 100%.")
endif()
run(0 "Array health: HEALTHY" raid status array0)
run(0 "disk2 +ONLINE +Present" raid members array0)
run(0 "Verified identical RAID 1 mirrors" raid verify array0)
run(0 "Text: Rebuilt mirror" raid read array0 20)
run(0 "disk2 +1 MiB +ONLINE +rebuild1 +No" spare list)
run(2 "belongs to RAID array" disk write disk0 20 forbidden)
file(SHA256 "${images}/disk0.img" retired)
file(SHA256 "${images}/disk2.img" rebuilt)
if(NOT original STREQUAL retired OR NOT original STREQUAL rebuilt)
    message(FATAL_ERROR "Rebuild did not preserve the old image and reproduce its bytes.")
endif()
file(REMOVE_RECURSE "${root}")
