cmake_minimum_required(VERSION 3.21)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/raid6-cli-${suffix}")
set(bin "${root}/build/Debug")
set(images "${root}/data/virtual_disks")
set(catalog "${root}/data/metadata/raid_arrays")
set(metadata "${catalog}/array0.raid")
file(MAKE_DIRECTORY "${bin}" "${root}/unrelated")
file(WRITE "${root}/CMakeLists.txt" "")
file(WRITE "${root}/CMakePresets.json" "{}")
file(COPY "${SIMULATOR}" DESTINATION "${bin}")
get_filename_component(name "${SIMULATOR}" NAME)
set(exe "${bin}/${name}")

function(run expected pattern)
    execute_process(COMMAND "${exe}" ${ARGN} WORKING_DIRECTORY "${root}/unrelated"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result STREQUAL "${expected}" OR NOT "${out}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Command [${ARGN}] returned ${result}. Output was [${out}${error}].")
    endif()
    set(lastOutput "${out}" PARENT_SCOPE)
endfunction()

function(checkOutput)
    foreach(pattern IN LISTS ARGN)
        if(NOT lastOutput MATCHES "${pattern}")
            message(FATAL_ERROR "Expected [${pattern}] in [${lastOutput}].")
        endif()
    endforeach()
endfunction()

foreach(index RANGE 0 7)
    run(0 "Created disk${index}" disk create disk${index} 1)
endforeach()
run(2 "between 4 and 257 members" raid create array0 raid6 disk0 disk1 disk2)
run(2 "must divide" raid create array0 raid6 disk0 disk1 disk2 disk3 --stripe 3)
run(2 "Duplicate RAID member" raid create array0 raid6 disk0 disk1 disk2 disk2)
run(1 "Cannot open RAID member disk9" raid create array0 raid6 disk0 disk1 disk2 disk9)
run(0 "Created array0 [(]RAID 6, 2 MiB usable" raid create array0 raid6 disk0 disk1 disk2 disk3)
run(2 "already belongs to RAID array array0" raid create array1 raid5 disk2 disk4 disk5)
run(0 "Created array1 [(]RAID 5, 2 MiB usable" raid create array1 raid5 disk4 disk5 disk6)
run(0 "RAID 6 +2 MiB" raid list)
checkOutput("RAID 5 +2 MiB")
run(0 "Raw capacity: 4 MiB" raid info array0)
checkOutput("Member count: 4" "Usable capacity: 2 MiB" "Parity overhead: 2 MiB" "Stripe unit: 16 blocks"
            "P/Q layout: rotating_pq_ascending_data_v1" "Member failure tolerance: 2" "Status: Healthy")
run(0 "Rows checked: 16" raid verify array0)
checkOutput("P mismatches: 0" "Q mismatches: 0" "Rows with errors: 0" "Result: PASSED")
run(0 "Data: disk1 physical LBA 4" raid map array0 20)
checkOutput("stripe row 0, data unit 1" "P: disk3 physical LBA 4" "Q: disk2 physical LBA 4")
run(0 "Data: disk3 physical LBA 16" raid map array0 48)
checkOutput("stripe row 1, data unit 1" "P: disk2 physical LBA 16" "Q: disk1 physical LBA 16")

run(0 "Wrote 11 UTF-8 bytes" raid write array0 20 "Hello RAID6")
checkOutput("Physical block reads: 3" "Physical block writes: 3" "Physical I/O requests: 6" "Partial-stripe rows: 1")
run(0 "Wrote 32 logical blocks" raid write-blocks array0 32 32 "Full stripe")
checkOutput("Physical block reads: 0" "Physical block writes: 64" "Physical I/O requests: 4" "Full-stripe rows: 1")
run(0 "Text: Hello RAID6" raid read array0 20)
run(0 "Text: Full stripe" raid read array0 63)
run(1 "outside the RAID array" raid read array0 512)
run(0 "Result: PASSED" raid verify array0)

foreach(index RANGE 0 3)
    file(SHA256 "${images}/disk${index}.img" before${index})
endforeach()
run(0 "Reconstructed data using P parity" raid demo-degraded-read array0 disk1 20)
checkOutput("Status: Degraded" "Text: Hello RAID6" "Physical block reads: 2")
run(0 "using P and Q parity" raid demo-degraded-read array0 disk1,disk0 20)
checkOutput("disk1,disk0 unavailable" "Text: Hello RAID6")
run(0 "using Q parity" raid demo-degraded-read array0 disk1,disk3 20)
checkOutput("disk1,disk3 unavailable" "Text: Hello RAID6")
run(0 "using P parity" raid demo-degraded-read array0 disk1,disk2 20)
checkOutput("disk1,disk2 unavailable" "Text: Hello RAID6")
run(0 "Read from disk1" raid demo-degraded-read array0 disk3,disk2 20)
checkOutput("disk3,disk2 unavailable" "Text: Hello RAID6" "Physical block reads: 1")
run(1 "more than two unavailable members" raid demo-degraded-read array0 disk0,disk1,disk2 20)
run(2 "distinct comma-separated" raid demo-degraded-read array0 disk1,disk1 20)
run(2 "only one unavailable member" raid demo-degraded-read array1 disk4,disk5 20)
run(2 "Raw write rejected" disk write disk1 4 forbidden)
run(0 "Status: Healthy" raid info array0)
foreach(index RANGE 0 3)
    file(SHA256 "${images}/disk${index}.img" after)
    if(NOT after STREQUAL before${index})
        message(FATAL_ERROR "Degraded-read demo or blocked raw write modified a member.")
    endif()
endforeach()
if(EXISTS "${catalog}/array0.pending")
    message(FATAL_ERROR "Degraded-read demo left a persistent marker.")
endif()

file(READ "${metadata}" valid)
string(REPLACE "layout=rotating_pq_ascending_data_v1" "layout=left_asymmetric_v1" invalid "${valid}")
file(WRITE "${metadata}" "${invalid}")
run(2 "Unsupported RAID 6 parity layout" raid info array0)
string(REPLACE "layout=rotating_pq_ascending_data_v1\n" "" missing "${valid}")
file(WRITE "${metadata}" "${missing}")
run(2 "Expected RAID metadata field layout" raid info array0)
file(WRITE "${metadata}" "${valid}")

# Corrupt an isolated fixture, then verify and reopen in independent CLI processes.
# This copy-based parity corruption fixture uses the legacy format. The identity
# replacement test separately verifies rejection for identity-bound arrays.
string(REGEX REPLACE "member_identities=[^\n]+\n" "" legacy "${valid}")
file(WRITE "${metadata}" "${legacy}")
file(COPY_FILE "${images}/disk7.img" "${images}/disk3.img")
run(1 "Rows with errors: 2" raid verify array0)
checkOutput("Rows checked: 16" "P mismatches: 2" "Q mismatches: 1" "Result: FAILED")
run(0 "Inconsistent [(]parity recovery required[)]" raid info array0)
run(1 "RAID 6 is inconsistent" raid read array0 20)
run(1 "RAID 6 is inconsistent" raid write array0 20 forbidden)
file(RENAME "${images}/disk1.img" "${images}/disk1.saved")
run(0 "disk1 +FAILED +Missing +MISSING_IMAGE" raid members array0)
run(2 "disk1 belongs" disk create disk1 1)
file(RENAME "${images}/disk1.saved" "${images}/disk1.img")
run(0 "disk1 +FAILED +Present +MISSING_IMAGE" raid members array0)
file(REMOVE_RECURSE "${root}")
