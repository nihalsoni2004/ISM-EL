cmake_minimum_required(VERSION 3.21)

string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${CMAKE_CURRENT_BINARY_DIR}/file-cli-${suffix}")
set(bin "${root}/bin")
set(store "${root}/data/metadata")
set(host "${root}/host")
file(MAKE_DIRECTORY "${bin}" "${host}")
file(WRITE "${root}/CMakeLists.txt" "")
file(WRITE "${root}/CMakePresets.json" "{}")
file(COPY "${SIMULATOR}" DESTINATION "${bin}")
get_filename_component(name "${SIMULATOR}" NAME)
set(exe "${bin}/${name}")
file(WRITE "${host}/sample.txt" "abc")
string(REPEAT "xy" 35000 large)
file(WRITE "${host}/large.bin" "${large}")

function(run expected pattern)
    execute_process(COMMAND "${exe}" ${ARGN} WORKING_DIRECTORY "${host}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err ENCODING UTF-8 TIMEOUT 35)
    if(NOT result STREQUAL "${expected}" OR NOT "${out}${err}" MATCHES "${pattern}")
        message(FATAL_ERROR "Command [${ARGN}] returned ${result}. Output was [${out}${err}].")
    endif()
endfunction()

run(0 "file import" --help)
run(0 "Created disk0" disk create disk0 1)
run(0 "Created disk1" disk create disk1 1)
run(0 "Created array0" raid create array0 raid1 disk0 disk1)
run(0 "pool0" pool create pool0 array0)
run(0 "LUN mode: FILE_MANAGED" lun create lun0 pool0 2 --mode file)
run(0 "LUN mode: RAW" lun create lun1 pool0 1)
run(0 "File ID" file list)
run(2 "file-managed" file import lun1 sample.txt)
run(0 "Import status: COMPLETED" file import lun0 sample.txt)
run(0 "file1.*sample.txt" file list lun0)
run(0 "Start LBA: 0" file info file1)
run(0 "Integrity: PASSED" file verify file1)
run(0 "Exported file1" file export file1 copy.txt)
file(SHA256 "${host}/sample.txt" source)
file(SHA256 "${host}/copy.txt" exported)
if(NOT source STREQUAL exported)
    message(FATAL_ERROR "Known file output differed from the source.")
endif()
run(1 "already exists" file export file1 copy.txt)
run(2 "Raw LUN write rejected" lun write lun0 0 forbidden)
run(2 "Raw LUN write rejected" lun write-blocks lun0 0 2 forbidden)

execute_process(COMMAND "${TESTER}" interrupt-import "${root}" "${host}/large.bin"
    RESULT_VARIABLE stopped OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT stopped STREQUAL "51")
    message(FATAL_ERROR "Importer did not exit after a storage write [${stopped}] [${output}${error}].")
endif()
run(0 "Worker process exited before completion" file info file2)
run(0 "Import status: FAILED" file info file2)
run(2 "Only completed files" file export file2 incomplete.bin)
run(0 "Start LBA: 19" file import lun0 large.bin)
run(0 "Completed files checked: 2" file verify-all lun0)
run(0 "Exported file3" file export file3 exported.bin)
file(SHA256 "${host}/large.bin" source)
file(SHA256 "${host}/exported.bin" exported)
if(NOT source STREQUAL exported OR EXISTS "${host}/incomplete.bin")
    message(FATAL_ERROR "Unexpected data from a completed or incomplete import.")
endif()

function(junction link target)
    file(TO_NATIVE_PATH "${link}" nativeLink)
    file(TO_NATIVE_PATH "${target}" nativeTarget)
    execute_process(COMMAND cmd.exe /d /c mklink /J "${nativeLink}" "${nativeTarget}" RESULT_VARIABLE status)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot create fixture junction")
    endif()
endfunction()

function(remove_junction link)
    file(TO_NATIVE_PATH "${link}" nativeLink)
    execute_process(COMMAND cmd.exe /d /c rmdir "${nativeLink}" RESULT_VARIABLE status)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot remove fixture junction")
    endif()
endfunction()

junction("${host}/alias" "${host}")
run(2 "reparse points" file import lun0 alias/sample.txt)
run(1 "reparse points" file export file1 alias/forbidden.txt)
remove_junction("${host}/alias")
run(1 "outside the simulator data directory" file export file1 "${store}/prohibited")
if(EXISTS "${host}/forbidden.txt" OR EXISTS "${store}/prohibited")
    message(FATAL_ERROR "An unsafe output path was used")
endif()
file(RENAME "${store}/storage_catalog.db" "${store}/saved.db")
junction("${store}/storage_catalog.db" "${host}")
run(2 "regular file without links" file list)
remove_junction("${store}/storage_catalog.db")
file(RENAME "${store}/saved.db" "${store}/storage_catalog.db")
junction("${store}/storage_catalog.db-journal" "${host}")
run(2 "regular file without links" file list)
remove_junction("${store}/storage_catalog.db-journal")
run(0 "Completed files checked: 2" file verify-all lun0)
file(REMOVE_RECURSE "${root}")
