cmake_minimum_required(VERSION 3.21)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
file(REAL_PATH "${CMAKE_CURRENT_BINARY_DIR}" parent)
set(root "${parent}/benchmark-cli-${suffix}")
file(MAKE_DIRECTORY "${root}/bin")
file(COPY "${SIMULATOR}" DESTINATION "${root}/bin")
get_filename_component(filename "${SIMULATOR}" NAME)
set(exe "${root}/bin/${filename}")
file(WRITE "${root}/CMakePresets.json" "{}")
file(WRITE "${root}/CMakeLists.txt" "")
set(config "${root}/trial.json")
file(WRITE "${config}" [=[
{"schema_version":1,"benchmark_name":"fixture","raid_level":1,"disk_capacity_mib":1,"workload":"RANDOM_WRITE",
 "footprint_blocks":64,"operation_count":2,"warmup_operations":0,"repetitions":1,"validation":"FULL"}
]=])
file(MAKE_DIRECTORY "${root}/data")
file(WRITE "${root}/data/sentinel.txt" "original storage")

function(invoke expected)
    execute_process(COMMAND "${exe}" benchmark ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out
        ERROR_VARIABLE err TIMEOUT 25 ENCODING UTF-8)
    if(NOT code STREQUAL expected)
        message(FATAL_ERROR "Expected ${expected}, received ${code} [${err}]")
    endif()
    set(output "${out}" PARENT_SCOPE)
endfunction()

invoke("0" dry-run --config "${config}" --output-dir trial)
string(JSON counts GET "${output}" temporary_image_bytes)
if(NOT counts EQUAL 2097152 OR EXISTS "${root}/benchmarks")
    message(FATAL_ERROR "Dry run reported incorrect budget or created files")
endif()
invoke("2" run --config "${config}" --output-dir "../outside")
invoke("0" list-presets)
invoke("0" run --config "${config}" --output-dir trial)
string(JSON id GET "${output}" run_id)
invoke("0" info "${id}" --output-dir trial)
string(JSON state GET "${output}" status)
file(READ "${root}/data/sentinel.txt" marker)
if(NOT state STREQUAL "COMPLETED" OR NOT marker STREQUAL "original storage")
    message(FATAL_ERROR "Unexpected final run status or modified original data")
endif()

file(REAL_PATH "${root}" resolved)
if(NOT resolved STREQUAL root OR NOT resolved MATCHES "/benchmark-cli-[0-9a-f]+$")
    message(FATAL_ERROR "Unexpected test workspace for cleanup")
endif()
file(REMOVE_RECURSE "${resolved}")
